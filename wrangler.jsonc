{
  "name": "fantasy",
  "main": "./_worker.js",
  "compatibility_date": "2026-08-31",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "auto-trailing-slash"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ARTICLE_COMMENTS",
        "class_name": "ArticleComments"
      }
    ]
  },
  "exports": {
    "ArticleComments": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
